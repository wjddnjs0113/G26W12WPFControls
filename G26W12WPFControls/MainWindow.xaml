<Window x:Class="G26W12WPFControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:G26W12WPFControls"
        mc:Ignorable="d"
        Title="노래 정보" Height="450" Width="400">
    <Border Padding="10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="노래 입력" 
                    FontWeight="Bold"
                    Margin="0, 10"/>
                <TextBlock Text="제목"/>
                <TextBox Padding="2"
                    Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="가수" Margin="0, 10, 0, 0"/>
                <TextBox Padding="2"
                    Text="{Binding Singer, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="장르" Margin="0, 10, 0, 0"/>
                <ComboBox Padding="2"
                    ItemsSource="{Binding Genres}"
                    SelectedItem="{Binding Genre}"/>

                <Button Content="추가" Margin="0, 20, 0, 0"
                    Command="{Binding AddSongCommand}"/>
            </StackPanel>

            <TextBox Margin="0, 20, 0, 0"
                IsReadOnly="True" Background="LightGray"
                AcceptsReturn="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{Binding Result, Mode=OneWay}"
                DockPanel.Dock="Bottom"/>
        </DockPanel>
    </Border>
</Window>